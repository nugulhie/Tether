# Copy to infra/.env (or run `make dev-env`, which generates a fresh key). Never commit infra/.env.
# Fernet key (32 random bytes, urlsafe base64) for stored prompts/responses. Development only:
# production keys come from the secret store, and a key that was ever committed must not be used.
CONTENT_ENCRYPTION_KEY=
# Rotation: CONTENT_ENCRYPTION_KEYS=<new id>:<new key>,default:<the key above>, restart, then
# `docker compose exec policy-api python -m app.rekey`; drop the old key once GET /v1/admin/audit/content/keys lists it as removable.
CONTENT_ENCRYPTION_KEYS=
