# Generated by infra/gpu/network/generate.py from config.yaml. Do not edit by hand.
# /etc/audit/rules.d/50-gpu-inference.rules: changes to serving, firewall and SSH configuration
# and every command run by a logged-in user are audited (G-7).
-w /etc/gpu-inference/ -p wa -k gpu-serving-config
-w /etc/nftables.conf -p wa -k gpu-firewall
-w /etc/nftables.d/ -p wa -k gpu-firewall
-w /etc/ssh/sshd_config -p wa -k gpu-sshd
-w /etc/ssh/sshd_config.d/ -p wa -k gpu-sshd
-w /etc/sssd/conf.d/ -p wa -k gpu-session-recording
-w /etc/tlog/ -p wa -k gpu-session-recording
-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=unset -k gpu-admin-exec
-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=unset -k gpu-admin-exec
