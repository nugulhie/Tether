# /etc/tether/tether.conf: the only file the customer fills in (docs/install-design.md, section 2).
# KEY=VALUE, no quotes. No secrets here: secrets are files, named by path (*_FILE).
# Then: sudo ./install/tether-install /etc/tether/tether.conf

# From the installation guide, not from the bundle: the SHA-256 of our release key (DER). The bundle is refused
# unless its release-key.pub has exactly this fingerprint.
RELEASE_KEY_SHA256=

# The address people's machines connect to (this server, on the office network), and optionally its DNS name.
TETHER_ADDRESS=
TETHER_HOSTNAME=

# Sign-in.
#   oidc: people sign in with the company IdP (Google Workspace, Microsoft Entra ID, Okta, Keycloak, ...) from the
#         `tether` command (device sign-in, RFC 8628). Register a sign-in app at the IdP first (installation guide).
#   mtls: no IdP: each person gets a personal certificate (`tether-admin user <name>`).
AUTH_MODE=oidc
# oidc: the IdP's issuer URL, e.g. https://accounts.google.com or https://login.microsoftonline.com/<tenant id>/v2.0
OIDC_ISSUER=
# oidc: the sign-in app's client ID, and its client secret where the IdP gives one to device apps (Google). That
# secret is not confidential for this kind of app: it ships to every person's machine.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# oidc, Google: the Workspace domain(s) whose accounts may sign in (required: otherwise any Google account could).
OIDC_HOSTED_DOMAINS=
# oidc: the scopes the device sign-in asks for. Empty = "openid email profile offline_access" (Google: "openid email profile").
OIDC_SCOPE=
# oidc: the ID-token claim with the person's groups (empty = groups; Google tokens have none), and the group(s)
# whose members are administrators.
OIDC_GROUPS_CLAIM=
ADMIN_GROUPS=
# oidc: on = each Mac also needs a device certificate (`tether-admin user <device>`), recorded with every session.
DEVICE_CERTIFICATES=off
# Administrators (comma-separated): oidc = sign-in e-mail addresses (and/or ADMIN_GROUPS); mtls = certificate names.
TETHER_ADMIN_USERS=
# 1 only where one person administers alone: they may approve their own jobs (recorded as self_approved).
SINGLE_ADMIN_APPROVAL=0

# Repositories agents may work on (GitHub organization). A GitHub App (private repositories) comes later.
GITHUB_ORG=

# Models. A self-hosted OpenAI-compatible engine on this host, bound to 127.0.0.1 (e.g. Ollama 11434);
# empty = none. External providers: a file holding the company API key; empty = "not configured".
LOCAL_INFERENCE_PORT=
ANTHROPIC_API_KEY_FILE=
OPENAI_API_KEY_FILE=

CONTENT_RETENTION_DAYS=90

# Step 6: where the policy signing private key is written. It must leave this server (USB stick, the
# administrator's machine): installation does not finish without it, and no copy stays here.
POLICY_SIGNING_KEY_EXPORT=

# Step 9: host firewall (SSH and 443 from the office network only). on | off
FIREWALL=on
# Networks allowed to reach SSH and 443 (comma-separated). Empty = the network of TETHER_ADDRESS.
ADMIN_NETWORKS=
