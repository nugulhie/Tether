# Host firewall of an installed Tether server (docs/install-design.md, step 9), the reference server's rules
# (infra/staging/firewall.nft) made persistent: tether-install prepends the defines, writes /etc/tether/firewall.nft
# and loads it with the tether-firewall service at boot. Its own table: Docker's and ufw's keep working.
# Docker-published ports (tls-front) are DNATed before this input chain; only host listeners are filtered here.
# Lines marked "# local-only" are dropped when there is no local inference engine.

table inet tether_host
delete table inet tether_host

table inet tether_host {
  chain input {
    type filter hook input priority filter; policy drop;
    iif lo accept
    ct state established,related accept
    ct state invalid drop
    meta l4proto icmp accept
    meta l4proto ipv6-icmp accept
    udp sport 67 udp dport 68 accept                       # DHCP lease renewals (losing the address = lockout)
    ip saddr $LAN tcp dport 22 accept                       # SSH from the office network
    ip saddr $LAN tcp dport 443 accept                      # people listener, if Docker serves it via docker-proxy
    ip saddr $LLM_GATEWAY tcp dport 8443 accept             # inference proxy (mTLS): the LLM gateway container only  # local-only
    ip saddr $TLS_FRONT tcp dport 8083 accept               # orchestrator API: tls-front only
    limit rate 6/minute log prefix "tether-fw drop in: " level info
  }

  chain output {
    type filter hook output priority filter; policy accept;
    # The inference engine talks to local clients only: no route out for prompts, responses or weights.
    meta skuid $ENGINE_UID oif != lo limit rate 6/minute log prefix "tether-fw drop engine out: " level warn  # local-only
    meta skuid $ENGINE_UID oif != lo drop  # local-only
  }
}
