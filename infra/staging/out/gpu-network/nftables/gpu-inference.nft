#!/usr/sbin/nft -f
# Generated by infra/gpu/network/generate.py from config.yaml. Do not edit by hand.
# ADR 0001 D2: default drop in/out/forward. Serving port only from the LLM gateway,
# SSH only from the bastion, egress only to the listed services. Drops are logged (rate limited).
# Own table only: other tables (e.g. a container runtime's) are left alone, and a drop in
# this table is final whatever they accept.

table inet gpu_guard
delete table inet gpu_guard

table inet gpu_guard {
	chain input {
		type filter hook input priority filter; policy drop;
		iif != "lo" ip daddr 127.0.0.0/8 drop comment "engine is loopback-only"
		iif != "lo" ip6 daddr ::1 drop
		iif "lo" accept
		ct state invalid drop
		ct state established,related accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, nd-router-solicit } ip6 hoplimit 255 accept
		ip saddr { 172.30.0.10/32 } tcp dport 8443 accept comment "llm-gateway -> mTLS proxy (G-1)"
		ip saddr { 192.168.1.52/32 } tcp dport 22 accept comment "bastion -> sshd (G-7)"
		ip saddr { 192.168.1.52/32 } icmp type echo-request limit rate 5/second accept
		limit rate 10/minute burst 20 packets log prefix "gpu-guard in drop: " level warn
		counter drop
	}

	chain forward {
		# GPU hosts route nothing. This also blocks container port publishing and container
		# egress: run the engine with host networking, bound to 127.0.0.1.
		type filter hook forward priority filter; policy drop;
		limit rate 10/minute burst 20 packets log prefix "gpu-guard fwd drop: " level warn
		counter drop
	}

	chain output {
		type filter hook output priority filter; policy drop;
		oif "lo" accept
		ct state invalid drop
		ct state established,related accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, nd-router-solicit } ip6 hoplimit 255 accept
		limit rate 10/minute burst 20 packets log prefix "gpu-guard out drop: " level warn
		counter drop
	}
}
